<Window x:Class="Sidelane.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidelane · Preferences" Width="492" Height="660" MinHeight="510" MinWidth="460"
        WindowStartupLocation="CenterOwner" Background="#1B1E22" Foreground="#EAECEA" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A4A8AF"/>
    <SolidColorBrush x:Key="Line" Color="#363B40"/>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C3C7C9"/><Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F1F1EF"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#262A2F"/><Setter Property="Foreground" Value="#F0F1EF"/>
      <Setter Property="BorderBrush" Value="#3D4147"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="#B9D8BF"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A5C4AE"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2A2E34"/><Setter Property="Foreground" Value="#DCE0DF"/>
      <Setter Property="BorderBrush" Value="#41464C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBody" CornerRadius="8" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBody" Property="BorderBrush" Value="#777C82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBody" Property="Opacity" Value="0.7"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#292D32"/><Setter Property="Foreground" Value="#21242A"/>
      <Setter Property="Padding" Value="7,6"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#CDD0D0"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,13"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1B1E22" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,21,26,19">
      <StackPanel>
        <TextBlock Text="Preferences" FontWeight="SemiBold" FontSize="21" Foreground="#F0F1EF"/>
        <TextBlock Text="Compact, personal, and out of your way." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Background="#1B1E22" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,6">
      <UniformGrid Columns="3">
        <Button Content="Appearance" Click="AppearanceNav_Click" Margin="0,0,6,0"/>
        <Button Content="Layout" Click="LayoutNav_Click" Margin="0,0,6,0"/>
        <Button Content="Apps" Click="AppsNav_Click"/>
      </UniformGrid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#1B1E22" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="23,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Validation" Grid.Column="0" Foreground="#E1B692" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
        <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Content="Save changes" Click="Save_Click" Background="#B9D8BF" BorderBrush="#B9D8BF" Foreground="#1A2720" FontWeight="SemiBold"/>
      </Grid>
    </Border>
    <ScrollViewer x:Name="PreferencesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="AppearanceSection" Text="Appearance" Style="{StaticResource SectionLabel}"/>
        <TextBlock Text="Color themes" Style="{StaticResource FieldLabel}"/>
        <UniformGrid Columns="4" Margin="0,0,0,12">
          <Button Content="Sage" Tag="#B9D8BF|#191C20" Background="#304A3D" BorderBrush="#52705E" Margin="0,0,7,0" Click="Palette_Click"/>
          <Button Content="Slate" Tag="#9BC9E2|#17212D" Background="#283F51" BorderBrush="#557389" Margin="0,0,7,0" Click="Palette_Click"/>
          <Button Content="Sand" Tag="#E9C7A3|#28211F" Background="#554137" BorderBrush="#7F5C47" Margin="0,0,7,0" Click="Palette_Click"/>
          <Button Content="Iris" Tag="#C9BBF1|#211D2D" Background="#453C63" BorderBrush="#6E6094" Click="Palette_Click"/>
        </UniformGrid>
        <Border x:Name="ThemePreview" CornerRadius="9" Background="#292D33" BorderBrush="#40464C" BorderThickness="1" Padding="12,9" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="AccentPreview" Fill="#B9D8BF" Width="19" Height="19" Margin="0,0,10,0"/>
            <TextBlock Text="Preview" Foreground="#ECEFED" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Text="   •   choose a preset or any color" Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,9,0">
            <TextBlock Text="Accent hex" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Pick" Margin="6,0,0,0" Padding="8,4" Click="PickAccent_Click"/><TextBox x:Name="AccentInput" MaxLength="7" ToolTip="Accent hex color" TextChanged="ColorInput_Changed"/></DockPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="9,0,0,0">
            <TextBlock Text="Surface hex (dark)" Style="{StaticResource FieldLabel}"/>
            <DockPanel><Button DockPanel.Dock="Right" Content="Pick" Margin="6,0,0,0" Padding="8,4" Click="PickBackground_Click"/><TextBox x:Name="BackgroundInput" MaxLength="7" ToolTip="Background hex color" TextChanged="ColorInput_Changed"/></DockPanel>
          </StackPanel>
        </Grid>
        <TextBlock Text="Typeface" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="FontCombo" Margin="0,0,0,16">
          <ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Consolas"/>
          <ComboBoxItem Content="Arial"/><ComboBoxItem Content="Georgia"/>
        </ComboBox>
        <TextBlock Text="Background image" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="ImagePath" ToolTip="Optional local PNG, JPG or BMP, up to 12 MB"/>
          <Button Grid.Column="1" Content="Browse" Click="Browse_Click" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Text="Optional. Images are dimmed so text stays readable." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,0,0,18"/>
        <Grid Margin="0,0,0,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}"/>
          <TextBlock x:Name="OpacityValue" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11"/>
        </Grid>
        <Slider x:Name="OpacityInput" Minimum="0.65" Maximum="1" TickFrequency="0.05" ValueChanged="Opacity_Changed" Margin="0,0,0,18"/>
        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,0,0,21"/>
        <Grid Margin="0,4,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="LayoutSection" Text="Sidebar dimensions" Style="{StaticResource SectionLabel}" Margin="0"/>
          <Button Grid.Column="1" Content="Reset size" Click="ResetSize_Click" Padding="9,4"/>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Collapsed rail width" Style="{StaticResource FieldLabel}"/>
          <TextBlock x:Name="RailWidthValue" Grid.Column="1" Foreground="{StaticResource Muted}"/>
        </Grid>
        <Slider x:Name="RailWidthInput" Minimum="42" Maximum="76" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="Size_Changed" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Expanded width" Style="{StaticResource FieldLabel}"/>
          <TextBlock x:Name="PanelWidthValue" Grid.Column="1" Foreground="{StaticResource Muted}"/>
        </Grid>
        <Slider x:Name="PanelWidthInput" Minimum="300" Maximum="520" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Size_Changed" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Panel height" Style="{StaticResource FieldLabel}"/>
          <TextBlock x:Name="PanelHeightValue" Grid.Column="1" Foreground="{StaticResource Muted}"/>
        </Grid>
        <Slider x:Name="PanelHeightInput" Minimum="360" Maximum="900" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="Size_Changed" Margin="0,0,0,8"/>
        <TextBlock Text="Dimensions use Windows display-independent pixels; height fits the monitor." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,0,0,21"/>
        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,0,0,21"/>
        <TextBlock Text="Behavior" Style="{StaticResource SectionLabel}"/>
        <TextBlock Text="Position" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="EdgeCombo" Margin="0,0,0,18">
          <ComboBoxItem Content="Left"/><ComboBoxItem Content="Right"/><ComboBoxItem Content="Free"/>
        </ComboBox>
        <CheckBox x:Name="AutoCollapseInput" Content="Expand on hover"/>
        <CheckBox x:Name="RespectFullscreenInput" Content="Stay behind fullscreen applications"/>
        <CheckBox x:Name="StartupAtLoginInput" Content="Open at Windows sign-in"/>
        <CheckBox x:Name="StartCollapsedInput" Content="Start as a narrow strip"/>
        <CheckBox x:Name="ShowTaskbarInput" Content="Show Sidelane on the taskbar"/>
        <CheckBox x:Name="AnimationsInput" Content="Enable subtle motion animations"/>
        <CheckBox x:Name="LockPositionInput" Content="Lock position" Margin="0,0,0,18"/>
        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,0,0,21"/>
        <TextBlock Text="Backup and restore" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
        <TextBlock Text="Export your saved appearance and shortcuts as JSON. Temporary notes and tasks are not included. Save changes before exporting." TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
          <Button Content="Export settings" Click="ExportSettings_Click" Margin="0,0,8,0"/>
          <Button Content="Import settings" Click="ImportSettings_Click"/>
        </StackPanel>
        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,0,0,21"/>
        <TextBlock x:Name="AppsSection" Text="Shortcuts" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
        <TextBlock Text="Choose your app shortcuts. Right-click a sidebar app to set a temporary activity note." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,13"/>
        <ListBox x:Name="ShortcutList" Height="112" Background="#25292D" Foreground="#E7E9E7" BorderBrush="#3D4248" DisplayMemberPath="Name" SelectionChanged="ShortcutList_SelectionChanged"/>
        <Grid Margin="0,12,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="App name" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameInput" MaxLength="28"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Symbol" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SymbolInput" MaxLength="2"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Match window title or process" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="MatchInput" MaxLength="100" Margin="0,0,0,11" ToolTip="Separate alternatives with |"/>
        <TextBlock Text="AI activity provider" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="StatusProviderCombo" Margin="0,0,0,9" ToolTip="Which provider should show observed browser activity? Auto matches the website.">
          <ComboBoxItem Content="Auto"/><ComboBoxItem Content="ChatGPT"/><ComboBoxItem Content="Claude"/>
          <ComboBoxItem Content="Grok"/><ComboBoxItem Content="None"/>
        </ComboBox>
        <TextBlock Text="Launch behavior" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="LaunchModeCombo" Margin="0,0,0,10" SelectionChanged="LaunchMode_Changed">
          <ComboBoxItem Content="Auto"/>
          <ComboBoxItem Content="Browser"/>
          <ComboBoxItem Content="App"/>
        </ComboBox>
        <TextBlock Text="Website URL" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="UrlInput" MaxLength="500" Margin="0,0,0,10" ToolTip="HTTPS or HTTP destination"/>
        <StackPanel x:Name="BrowserFields">
          <TextBlock Text="Open website with" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="BrowserCombo" Margin="0,0,0,9">
            <ComboBoxItem Content="Default"/><ComboBoxItem Content="Chrome"/>
            <ComboBoxItem Content="Edge"/><ComboBoxItem Content="Firefox"/><ComboBoxItem Content="Brave"/>
          </ComboBox>
          <CheckBox x:Name="BrowserAppWindowInput" Content="Open as a standalone web app (Chrome, Edge, Brave)" Margin="0,0,0,11"/>
        </StackPanel>
        <StackPanel x:Name="AppFields">
          <TextBlock Text="Desktop application (.exe or .lnk shortcut)" Style="{StaticResource FieldLabel}"/>
          <DockPanel Margin="0,0,0,9">
            <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseApp_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="AppPathInput" MaxLength="1024" ToolTip="Choose an app or Windows shortcut, including a shortcut to a Store app"/>
          </DockPanel>
          <TextBlock Text="Use App mode to launch this program. Auto checks open windows first." TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,0,0,11"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
          <Button Content="New" Click="NewShortcut_Click" Margin="0,0,8,0"/>
          <Button Content="Remove" Click="RemoveShortcut_Click" Margin="0,0,8,0"/>
          <Button Content="Apply shortcut" Click="ApplyShortcut_Click"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
