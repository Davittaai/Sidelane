<Window x:Class="Sidelane.SetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Welcome to Sidelane" Width="640" Height="730" MinWidth="560" MinHeight="600"
 WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
 Background="#161A1E" Foreground="#ECF0EC" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Mute" Color="#9DA9A9"/>
  <Style TargetType="TextBlock" x:Key="Section">
   <Setter Property="Foreground" Value="#F1F4F2"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#2B3338"/>
   <Setter Property="Foreground" Value="#EEF1EE"/>
   <Setter Property="BorderBrush" Value="#414A4D"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="37"/>
   <Setter Property="Padding" Value="13,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#DCE5E0"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Margin" Value="0,0,0,11"/>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Foreground" Value="#DFE7E2"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Margin" Value="0,2,0,3"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#2D3438"/>
   <Setter Property="Foreground" Value="#151A1E"/>
   <Setter Property="Padding" Value="8,7"/>
  </Style>
 </Window.Resources>
 <DockPanel LastChildFill="True">
  <Border DockPanel.Dock="Top" Background="#20282A" Padding="28,24" BorderBrush="#344340" BorderThickness="0,0,0,1">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" CornerRadius="12" Background="#2B4237" VerticalAlignment="Top">
     <Image Source="pack://application:,,,/Assets/sidelane-app-icon.png" Width="36" Height="36" Stretch="Uniform"/>
    </Border>
    <StackPanel Grid.Column="1">
     <TextBlock Text="Build your workspace" Foreground="#F1F6F2" FontWeight="SemiBold" FontSize="24"/>
     <TextBlock Text="Your tools, one small place. Set up in less than a minute." FontSize="12" Foreground="#A9B8B2" Margin="0,7,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#1C2226" BorderBrush="#364039" BorderThickness="0,1,0,0" Padding="24,14">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
     <TextBlock x:Name="Validation" Foreground="#E6BC91" FontSize="11" TextWrapping="Wrap"/>
     <TextBlock Text="No account. No cloud sync. You control your shortcuts." Foreground="#93A49C" FontSize="10" TextWrapping="Wrap"/>
    </StackPanel>
    <Button Grid.Column="1" Content="Use defaults" Margin="0,0,10,0" Click="Skip_Click"/>
    <Button x:Name="FinishButton" IsEnabled="False" Grid.Column="2" Content="Create my workspace" Background="#B9D8BF" Foreground="#15261B" BorderBrush="#B9D8BF" FontWeight="SemiBold" Click="Finish_Click"/>
   </Grid>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="27,16,27,12">
    <Grid Margin="0,0,0,9">
     <TextBlock Text="01  YOUR TOOLS" Foreground="#82A894" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
     <TextBlock Text="Choose what appears on the rail" HorizontalAlignment="Right" Foreground="#9DACAA" FontSize="11"/>
    </Grid>
    <Border Padding="18,16" Background="#22282D" CornerRadius="13" BorderBrush="#373F43" BorderThickness="1">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel>
       <CheckBox x:Name="ChatGPTCheck" Content="ChatGPT" IsChecked="True"/>
       <CheckBox x:Name="ClaudeCheck" Content="Claude" IsChecked="True"/>
       <CheckBox x:Name="GrokCheck" Content="Grok" IsChecked="True" Margin="0"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
       <CheckBox x:Name="CodexCheck" Content="Codex" IsChecked="True"/>
       <CheckBox x:Name="VSCodeCheck" Content="VS Code" IsChecked="True"/>
       <TextBlock Text="You can change these later." Foreground="{StaticResource Mute}" FontSize="10.5"/>
      </StackPanel>
     </Grid>
    </Border>
    <TextBlock Text="02  HOW TO OPEN THEM" Foreground="#82A894" FontWeight="Bold" FontSize="10" Margin="0,17,0,9"/>
    <Border Padding="18,15" Background="#22282D" CornerRadius="13" BorderBrush="#373F43" BorderThickness="1">
     <StackPanel>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Preferred browser" Style="{StaticResource Section}" VerticalAlignment="Center"/>
       <TextBlock x:Name="BrowserInfo" Grid.Column="1" Foreground="{StaticResource Mute}" FontSize="10" VerticalAlignment="Center" Text="Checking installed browsers..."/>
      </Grid>
      <ComboBox x:Name="BrowserChoice" AutomationProperties.Name="Preferred browser for AI tools">
       <ComboBoxItem Content="Default" IsSelected="True"/>
      </ComboBox>
      <CheckBox x:Name="PreferAppsCheck" Content="Use installed desktop apps when available" Margin="0,15,0,8" IsChecked="True"/>
      <TextBlock x:Name="InstalledInfo" Foreground="{StaticResource Mute}" FontSize="11" TextWrapping="Wrap"
       Text="Checking Windows Start Menu for matching shortcuts. No program will be launched."/>
     </StackPanel>
    </Border>
    <TextBlock Text="03  MAKE IT YOURS" Foreground="#82A894" FontWeight="Bold" FontSize="10" Margin="0,17,0,9"/>
    <Border Padding="18,15" Background="#22282D" CornerRadius="13" BorderBrush="#373F43" BorderThickness="1">
     <StackPanel>
      <TextBlock Text="Color scheme" Style="{StaticResource Section}" Margin="0,0,0,8"/>
      <UniformGrid Columns="4">
       <RadioButton x:Name="SageTheme" Content="Sage" Tag="#B9D8BF|#191C20" GroupName="theme" IsChecked="True"/>
       <RadioButton x:Name="SlateTheme" Content="Slate" Tag="#9BC9E2|#17212D" GroupName="theme"/>
       <RadioButton x:Name="SandTheme" Content="Sand" Tag="#E9C7A3|#28211F" GroupName="theme"/>
       <RadioButton x:Name="IrisTheme" Content="Iris" Tag="#C9BBF1|#211D2D" GroupName="theme"/>
      </UniformGrid>
      <CheckBox x:Name="TaskbarCheck" Content="Show Sidelane on the taskbar" Margin="0,13,0,0" IsChecked="True"/>
     </StackPanel>
    </Border>
    <TextBlock Text="You can edit every shortcut, size and appearance setting later in Preferences." Foreground="#97A8A0"
     TextWrapping="Wrap" FontSize="11" Margin="2,10,0,0"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>