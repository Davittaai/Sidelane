<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Sidelane</AssemblyName>
    <RootNamespace>Sidelane</RootNamespace>
    <Version>2.0.0-beta.1</Version>
    <ApplicationIcon>Assets\sidelane.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\\sidelane.ico" />
    <Resource Include="../../docs/sidelane-app-icon.png" Link="Assets/sidelane-app-icon.png" />
  </ItemGroup>
</Project>
